{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "description": "Distribution of species across Australian states",
  "projection": {"type": "mercator"},
  "data": {
    "url": "../data_source/AUS_state_topo.json",
    "format": {"type": "topojson", "feature": "STE_2016_AUST"}
  },
  "transform": [
    {
      "lookup": "properties.STE_NAME16",
      "from": {
        "data": {
          "url": "../data_source/aus_state_dist.csv",
          "format": {"type": "csv"}
        },
        "key": "State",
        "fields": ["State","TotalSpecies","Squamata","Testudines","Crocodilia"]
      }
    },
    {"calculate": "toNumber(datum.TotalSpecies) + 0.1", "as": "Total Species"}
  ],
  "mark": {"type": "geoshape"},
  "encoding": {
    "color": {
      "field": "Total Species",
      "type": "quantitative",
      "scale": {"type": "sqrt", "scheme": "goldgreen"}
    },
    "tooltip": [
      {"field": "properties.STE_NAME16", "type": "nominal", "title": "State"},
      {"field": "TotalSpecies", "type": "quantitative", "title": "Species"},
      {"field": "Squamata", "type":"nominal", "title": "Snakes and Lizards"},
      {"field": "Testudines", "type":"nominal", "title": "Turtles"},
      {"field": "Crocodilia", "type":"nominal", "title": "Crocodiles"}
    ]
  },
  "config": {
    "background": "transparent"
  }
}